<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Reuses Spring Boot's own CONSOLE appender + logging.pattern.console property (kept
         as-is, ADR-0018) so introducing this file doesn't change local console output. -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Ships every event as OTLP via the OpenTelemetry instance OtelLogging installs
         (ADR-0018). captureKeyValuePairAttributes carries RegistrationEventLog's structured
         clientId/transaction/eventType/result fields through as Log Record Attributes. -->
    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureKeyValuePairAttributes>true</captureKeyValuePairAttributes>
    </appender>

    <logger name="com.registration.server" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </logger>

    <!-- RegistrationEventLog lives in common (com.registration.common.observability), not
         com.registration.client - its own TRACE/DEBUG calls need this separate override or
         they inherit root's INFO threshold and get dropped before reaching any appender. -->
    <logger name="com.registration.common" level="TRACE" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </logger>

    <!-- The OTel SDK/exporter's own diagnostics (e.g. "Failed to export logs" when the
         Collector is unreachable) must never flow back into the OTEL appender - otherwise a
         downed Collector logs its own connection failure via the same broken export pipeline
         it's complaining about, feeding itself indefinitely. CONSOLE-only keeps the failure
         visible without that loop; the Collector being unreachable must never affect request
         handling either way (BatchLogRecordProcessor exports off the request thread and drops
         on failure), this only stops the noise/self-feedback. -->
    <logger name="io.opentelemetry" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
